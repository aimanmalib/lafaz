{
  "app": {
    "name": "Lafaz",
    "public_url": "https://lafaz.sasateguh.com",
    "default_lang": "en",
    "languages": [
      "en",
      "ms"
    ],
    "lang_cookie": "lafaz_lang",
    "lang_cookie_days": 365,
    "timezone": "Asia/Kuala_Lumpur",
    "db_path_default": "state/lafaz.db",
    "noindex": true
  },
  "rung": {
    "current": 3,
    "levels": {
      "2": "rung.2",
      "3": "rung.3"
    }
  },
  "llm": {
    "model": "claude-sonnet-5-5",
    "effort": "medium",
    "max_tokens": 16000,
    "fallbacks": "default",
    "timeout_s": 60,
    "key_env": "ANTHROPIC_API_KEY"
  },
  "run_limits": {
    "max_steps": 12,
    "max_seconds": 90,
    "max_cost_usd": 0.15
  },
  "listen": {
    "min_quote_words": 3
  },
  "public_budget": {
    "usd_per_day": 5,
    "runs_per_ip_per_day": 20,
    "trusted_proxy_header": "cf-connecting-ip",
    "cloudflare_ranges_source": "https://www.cloudflare.com/ips-v4 and /ips-v6, copied 2026-11-21",
    "cloudflare_ranges": [
      "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22", "141.101.64.0/18",
      "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20", "197.234.240.0/22", "198.41.128.0/17",
      "162.158.0.0/15", "104.16.0.0/13", "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22",
      "2400:cb00::/32", "2606:4700::/32", "2803:f800::/32", "2405:b500::/32", "2405:8100::/32",
      "2a06:98c0::/29", "2c0f:f248::/32"
    ]
  },
  "scheduler": {
    "reminder_check_seconds": 300
  },
  "input": {
    "max_chars": 12000
  },
  "agent": {
    "redact_keys": [
      "password",
      "secret",
      "token",
      "api_key",
      "authorization"
    ],
    "reminder_max_days_before": 14,
    "result_max_chars": 2000
  },
  "run_page": {
    "poll_seconds": 2
  },
  "eval": {
    "tasks_dir": "evals/tasks",
    "results_dir": "evals/results",
    "measured_path": "docs/MEASURED.md",
    "workers": 4,
    "rejected_examples": 3,
    "trace_max_steps": 30
  }
}
