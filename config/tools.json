{
  "_note": "Single source of truth for what each tool may do. The agent loop reads 'kategori' (permission category); nothing in code hard-codes it. Tools with stage 'plan' are offered to the agent loop.",
  "tools": [
    {
      "name": "record_items",
      "kategori": "read",
      "enabled": true,
      "description": "Record decisions, action items, questions and facts heard in the input, each with exact quotes.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "questions"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text",
                "owner",
                "due_phrase",
                "quotes",
                "corrects",
                "confidence"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "decision",
                    "action",
                    "question",
                    "fact"
                  ]
                },
                "text": {
                  "type": "string",
                  "description": "The item in plain words, in the language of the input."
                },
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Name as spoken, or null if nobody was named. Do not guess."
                },
                "due_phrase": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The deadline words exactly as spoken (for example 'by Wednesday', 'lusa'), or null. Never a computed date."
                },
                "quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "One or more exact spans copied from the input, each at least three words."
                },
                "corrects": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "old_quote",
                        "new_quote"
                      ],
                      "properties": {
                        "old_quote": {
                          "type": "string"
                        },
                        "new_quote": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "When the speaker corrected themselves: the earlier words and the words that replace them, both copied exactly."
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                }
              }
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_index",
                "question",
                "quote"
              ],
              "properties": {
                "item_index": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "question": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "description": "Exact span from the input that raised the question."
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "judge_conflict",
      "kategori": "read",
      "enabled": true,
      "description": "Decide whether a new decision contradicts one earlier active decision. Quote the words of each, copied exactly from its own meeting.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict",
          "old_quote",
          "new_quote",
          "reason"
        ],
        "properties": {
          "conflict": {
            "type": "boolean",
            "description": "True only when both decisions cannot hold at the same time."
          },
          "old_quote": {
            "type": "string",
            "description": "Exact span from the earlier meeting text, at least three words."
          },
          "new_quote": {
            "type": "string",
            "description": "Exact span from the new meeting text, at least three words."
          },
          "reason": {
            "type": "string",
            "description": "One plain sentence, in the language of the new meeting."
          }
        }
      }
    },
    {
      "name": "replace_decision",
      "kategori": "reversible",
      "enabled": true,
      "description": "Mark the earlier decision as replaced by the new one. Can be undone.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_id"
        ],
        "properties": {
          "conflict_id": {
            "type": "integer"
          }
        }
      },
      "stage": "card"
    },
    {
      "name": "keep_both_decisions",
      "kategori": "reversible",
      "enabled": true,
      "description": "Keep both decisions active and close the conflict card. Can be undone.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_id"
        ],
        "properties": {
          "conflict_id": {
            "type": "integer"
          }
        }
      },
      "stage": "card"
    },
    {
      "name": "create_task",
      "kategori": "reversible",
      "enabled": true,
      "description": "Create one task on the internal board from an accepted action item. Owner, due date and quote are taken from that item by code. Can be undone.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_index",
          "title"
        ],
        "properties": {
          "item_index": {
            "type": "integer",
            "description": "Index of the accepted action item in the Understood list."
          },
          "title": {
            "type": "string",
            "description": "Short task title in the language of the input."
          }
        }
      },
      "stage": "plan"
    },
    {
      "name": "preview_summary",
      "kategori": "reversible",
      "enabled": true,
      "description": "Draft the weekly digest for one person who owns an item in this meeting. Nothing is sent. Can be undone.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person",
          "body"
        ],
        "properties": {
          "person": {
            "type": "string",
            "description": "Name exactly as listed in the Understood items."
          },
          "body": {
            "type": "string",
            "description": "The digest text."
          }
        }
      },
      "stage": "plan"
    },
    {
      "name": "publish_to_board",
      "kategori": "irreversible",
      "enabled": true,
      "description": "Publish tasks created in this run to the shared team board where others see them. Needs a person's approval.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_ids"
        ],
        "properties": {
          "task_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Ids returned by create_task in this run."
          }
        }
      },
      "stage": "plan"
    },
    {
      "name": "send_reminder",
      "kategori": "irreversible",
      "enabled": true,
      "description": "Ask a person to approve a reminder policy for one task: email its owner a set number of days before the due date. Once approved, Lafaz sends it on that day within the policy limits.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "days_before",
          "message"
        ],
        "properties": {
          "task_id": {
            "type": "integer"
          },
          "days_before": {
            "type": "integer",
            "description": "Whole days before the due date."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "stage": "plan"
    },
    {
      "name": "send_summary",
      "kategori": "irreversible",
      "enabled": true,
      "description": "Email the weekly digest to one person. Needs a person's approval.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person",
          "subject",
          "body"
        ],
        "properties": {
          "person": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "stage": "plan"
    },
    {
      "name": "ask_team",
      "kategori": "irreversible",
      "enabled": true,
      "description": "Email the team to settle an open question, quoting the words that raised it. Needs a person's approval.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "body",
          "quote"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "description": "Exact span from the input, at least three words."
          }
        }
      },
      "stage": "plan"
    }
  ]
}
