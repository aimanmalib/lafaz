# Copy to deploy/hos.env (not tracked) and fill in the host values.
LAFAZ_DOMAIN=lafaz.example.com
LAFAZ_NETWORK=proxy            # docker network the reverse proxy shares with the app
PROXY_CONTAINER=proxy          # reverse proxy container (Traefik with a file provider)
PROXY_DYNAMIC_DIR=/traefik/dynamic
CERT_RESOLVER=letsencrypt
LAFAZ_ENV_FILE=                # optional: file with ANTHROPIC_API_KEY, mode 0600
LAFAZ_MAIL_ENV_FILE=           # optional: LAFAZ_SMTP_USER, LAFAZ_SMTP_PASSWORD, LAFAZ_OWNER_TOKEN, mode 0600
BUILD_CMD="docker build"       # any builder that accepts `docker build` arguments
MIN_FREE_GB=20
