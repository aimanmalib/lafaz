# Route for the public host name to the lafaz container. deploy/deploy.sh fills the @...@ values from
# deploy/hos.env and copies the result into the proxy's dynamic configuration folder.
# HTML is sent with `Cache-Control: no-transform`, so a CDN in front does not compress it: the `compress`
# middleware here does. Its default 1024-byte floor would skip small pages, so the floor is lowered.
# Plain http redirects to https; Traefik answers the ACME http challenge itself before this router.
http:
  routers:
    lafaz:
      entryPoints: [https]
      rule: Host(`@DOMAIN@`)
      service: lafaz-svc
      middlewares: [lafaz-compress]
      tls:
        certResolver: @CERT_RESOLVER@
      priority: 100
    lafaz-http:
      entryPoints: [http]
      rule: Host(`@DOMAIN@`)
      service: lafaz-svc
      middlewares: [lafaz-https]
      priority: 100
  middlewares:
    lafaz-compress:
      compress:
        minResponseBodyBytes: 256
        excludedContentTypes: [image/png, image/jpeg, image/webp, font/woff2]
    lafaz-https:
      redirectScheme:
        scheme: https
        permanent: true
  services:
    lafaz-svc:
      loadBalancer:
        servers:
          - url: http://lafaz:8080
